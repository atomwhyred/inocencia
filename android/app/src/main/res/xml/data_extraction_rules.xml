<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" ya no impide la transferencia de un teléfono a otro.
     Los perfiles, el historial y los hash de los PIN de los niños no salen del teléfono:
     ni a la nube ni al cambiar de móvil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
